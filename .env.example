# Copiar a .env.local y completar con valores reales. No commitear .env.local.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Service role key: bypassa RLS, solo server-side. NUNCA exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
# Permite saltear el chequeo de auth en middleware (solo dev/testing local)
BYPASS_AUTH=false

# --- Vex (IA - Groq) ---
GROQ_API_KEY=your-groq-api-key
# Modelo principal usado por Vex para scoring/mensajes/resúmenes
VEX_MODEL=llama-3.3-70b-versatile
# Modelo de fallback si el principal falla o está rate-limited
VEX_MODEL_FALLBACK=llama-3.1-8b-instant
# Modelo usado para generar embeddings (búsqueda semántica)
VEX_EMBED_MODEL=your-embedding-model

# --- Gemini (IA, uso alternativo) ---
GEMINI_API_KEY=your-gemini-api-key

# --- YouTube ---
YOUTUBE_API_KEY=your-youtube-api-key

# --- Google Calendar / OAuth ---
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# Refresh token obtenido en el flujo OAuth para acceso offline a Calendar
GOOGLE_REFRESH_TOKEN=your-google-refresh-token
GOOGLE_CALENDAR_ID=primary
# Token secreto para validar webhooks entrantes de Google Calendar
GOOGLE_WEBHOOK_TOKEN=your-google-webhook-token

# --- Cloudflare TURN (WebRTC llamadas) ---
CLOUDFLARE_TURN_KEY_ID=your-cloudflare-turn-key-id
CLOUDFLARE_TURN_API_TOKEN=your-cloudflare-turn-api-token

# --- Web Push (notificaciones) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
# Email/mailto de contacto requerido por la spec VAPID
VAPID_SUBJECT=mailto:contacto@tryvex.tech

# --- Resend (email transaccional) ---
RESEND_API_KEY=your-resend-api-key

# --- WhatsApp Business API ---
WHATSAPP_TOKEN=your-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
WHATSAPP_TEMPLATE_NAME=your-whatsapp-template-name
WHATSAPP_TEMPLATE_LANG=es

# --- Agente de WhatsApp (repo Vex-Agente) ---
# De dónde saca el CRM el QR de vinculación que se muestra en /settings/whatsapp.
# Tiene que ser alcanzable por HTTPS desde Vercel: el wa-bridge no sirve para
# esto porque escucha en 127.0.0.1.
VEX_AGENT_URL=https://agente.tu-dominio.com
# El MISMO valor que TRYVEX_AGENT_TOKEN en el .env.local del agente. Viaja en la
# cabecera Authorization y nunca llega al navegador.
VEX_AGENT_TOKEN=txa_tu-token-de-agente

# --- WhatsApp Bridge (puente propio, en retirada) ---
# Sigue enviando los mensajes salientes. El QR ya no sale de acá.
WA_BRIDGE_URL=http://localhost:PORT
# Token para autorizar solicitudes del QR de vinculación del bridge de WhatsApp
WA_BRIDGE_QR_TOKEN=your-wa-bridge-qr-token

# --- Scraper / integraciones externas ---
# Secreto para validar webhooks entrantes del scraper de leads
SCRAPER_WEBHOOK_SECRET=your-scraper-webhook-secret

# --- Cron jobs (Vercel Cron u otro scheduler) ---
# Secreto para autorizar llamadas a endpoints de cron
CRON_SECRET=your-cron-secret

# --- Landing (revalidación de contenido estático) ---
LANDING_REVALIDATE_URL=https://tryvex.tech/api/revalidate
LANDING_REVALIDATE_SECRET=your-landing-revalidate-secret

# --- Transporte de WhatsApp (transición del puente al agente) ---
# 'puente' (por defecto) escribe en outreach_messages y el wa-bridge lo recoge.
# 'vex' manda por el agente vía HTTPS, que es el destino: un solo transporte,
# con freno de baneo y sin Chromium.
# NO cambiar a 'vex' hasta que el agente esté desplegado y verificado: con los
# dos vinculados al mismo número hay dos sesiones automatizadas a la vez.
WA_TRANSPORTE=puente
